# 复制本文件为 .env，填入你自己打印机的信息
# 获取方式见 README「三步拿到凭据」

# 打印机局域网 IP（打印机屏幕: 设置 → 网络 可查看）
PRINTER_IP=192.168.1.100

# 打印机序列号（打印机屏幕: 设置 → 设备信息，SN 一栏）
PRINTER_SERIAL=你的打印机SN

# LAN 访问码（打印机屏幕: 设置 → 网络 → 局域网模式，Access Code）
PRINTER_ACCESS_CODE=你的访问码

# 以下均可不改
# PRINTER_PORT=8883
# GO2RTC_URL=http://127.0.0.1:1984
# STREAM_NAME=bambu
# PORT=8080
